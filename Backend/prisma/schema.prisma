generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  department   String?
  role         UserRole @default(STAFF)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  receiptsCreated   Receipt[]    @relation("ReceiptCreator")
  receiptsValidated Receipt[]    @relation("ReceiptValidator")
  deliveriesCreated Delivery[]   @relation("DeliveryCreator")
  transfersCreated  Transfer[]   @relation("TransferCreator")
  adjustmentsCreated Adjustment[] @relation("AdjustmentCreator")

  @@map("users")
}

enum UserRole {
  ADMIN
  MANAGER
  STAFF
}

model Warehouse {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  location  String
  capacity  String
  status    WarehouseStatus @default(ACTIVE)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stock              Stock[]
  receipts           Receipt[]
  deliveries         Delivery[]
  transfersFrom      Transfer[] @relation("TransferFrom")
  transfersTo        Transfer[] @relation("TransferTo")
  adjustments        Adjustment[]
  stockMovements     StockMovement[]

  @@map("warehouses")
}

enum WarehouseStatus {
  ACTIVE
  INACTIVE
}

model Product {
  id           String   @id @default(uuid())
  sku          String   @unique
  name         String
  category     String
  unit         String
  reorderLevel Int      @map("reorder_level")
  description  String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  stock          Stock[]
  receiptLines   ReceiptLine[]
  deliveryLines  DeliveryLine[]
  transfers      Transfer[]
  adjustments    Adjustment[]
  stockMovements StockMovement[]

  @@map("products")
}

model Stock {
  id          String   @id @default(uuid())
  productId   String   @map("product_id")
  warehouseId String   @map("warehouse_id")
  quantity    Decimal  @db.Decimal(10, 2)
  lastUpdated DateTime @default(now()) @map("last_updated")

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId])
  @@map("stock")
}

model Receipt {
  id             String        @id @default(uuid())
  receiptNumber  String        @unique @map("receipt_number")
  supplierName   String        @map("supplier_name")
  warehouseId    String        @map("warehouse_id")
  status         ReceiptStatus @default(DRAFT)
  expectedDate   DateTime      @map("expected_date") @db.Date
  validatedAt    DateTime?     @map("validated_at")
  validatedBy    String?       @map("validated_by")
  createdBy      String        @map("created_by")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  warehouse Warehouse     @relation(fields: [warehouseId], references: [id])
  creator   User          @relation("ReceiptCreator", fields: [createdBy], references: [id])
  validator User?         @relation("ReceiptValidator", fields: [validatedBy], references: [id])
  lines     ReceiptLine[]

  @@map("receipts")
}

enum ReceiptStatus {
  DRAFT
  WAITING
  VALIDATED
}

model ReceiptLine {
  id        String  @id @default(uuid())
  receiptId String  @map("receipt_id")
  productId String  @map("product_id")
  quantity  Decimal @db.Decimal(10, 2)
  unit      String

  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("receipt_lines")
}

model Delivery {
  id             String         @id @default(uuid())
  deliveryNumber String         @unique @map("delivery_number")
  customerName   String         @map("customer_name")
  warehouseId    String         @map("warehouse_id")
  status         DeliveryStatus @default(DRAFT)
  deliveryDate   DateTime       @map("delivery_date") @db.Date
  shippedAt      DateTime?      @map("shipped_at")
  createdBy      String         @map("created_by")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  warehouse Warehouse      @relation(fields: [warehouseId], references: [id])
  creator   User           @relation("DeliveryCreator", fields: [createdBy], references: [id])
  lines     DeliveryLine[]

  @@map("deliveries")
}

enum DeliveryStatus {
  DRAFT
  PICKING
  PACKING
  READY
  SHIPPED
}

model DeliveryLine {
  id         String  @id @default(uuid())
  deliveryId String  @map("delivery_id")
  productId  String  @map("product_id")
  quantity   Decimal @db.Decimal(10, 2)
  unit       String

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@map("delivery_lines")
}

model Transfer {
  id              String         @id @default(uuid())
  transferNumber  String         @unique @map("transfer_number")
  productId       String         @map("product_id")
  fromWarehouseId String         @map("from_warehouse_id")
  toWarehouseId   String         @map("to_warehouse_id")
  quantity        Decimal        @db.Decimal(10, 2)
  status          TransferStatus @default(READY)
  transferDate    DateTime       @map("transfer_date") @db.Date
  completedAt     DateTime?      @map("completed_at")
  createdBy       String         @map("created_by")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  product       Product   @relation(fields: [productId], references: [id])
  fromWarehouse Warehouse @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse @relation("TransferTo", fields: [toWarehouseId], references: [id])
  creator       User      @relation("TransferCreator", fields: [createdBy], references: [id])

  @@map("transfers")
}

enum TransferStatus {
  READY
  DONE
}

model Adjustment {
  id                String   @id @default(uuid())
  adjustmentNumber  String   @unique @map("adjustment_number")
  productId         String   @map("product_id")
  warehouseId       String   @map("warehouse_id")
  recordedQuantity  Decimal  @map("recorded_quantity") @db.Decimal(10, 2)
  countedQuantity   Decimal  @map("counted_quantity") @db.Decimal(10, 2)
  difference        Decimal  @db.Decimal(10, 2)
  reason            String
  adjustmentDate    DateTime @map("adjustment_date") @db.Date
  createdBy         String   @map("created_by")
  createdAt         DateTime @default(now()) @map("created_at")

  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  creator   User      @relation("AdjustmentCreator", fields: [createdBy], references: [id])

  @@map("adjustments")
}

model StockMovement {
  id              String   @id @default(uuid())
  productId       String   @map("product_id")
  warehouseId     String   @map("warehouse_id")
  movementType    MovementType @map("movement_type")
  referenceId     String   @map("reference_id")
  referenceNumber String   @map("reference_number")
  quantityChange  Decimal  @map("quantity_change") @db.Decimal(10, 2)
  quantityBefore  Decimal  @map("quantity_before") @db.Decimal(10, 2)
  quantityAfter   Decimal  @map("quantity_after") @db.Decimal(10, 2)
  createdAt       DateTime @default(now()) @map("created_at")

  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@map("stock_movements")
}

enum MovementType {
  RECEIPT
  DELIVERY
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
}
